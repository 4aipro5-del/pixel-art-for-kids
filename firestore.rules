rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// classes / classes/{classId}/students — 학급·학생 관리 (프롬프트 A + B + C 반영)
//
// 핵심 원칙:
// 1) 학급 생성(createClass)·학생 별명 등록(registerStudents)·학생 등록·PIN 로그인
//    (joinOrLoginStudent)은 전부 Cloud Functions(Admin SDK)에서만 처리한다.
//    Admin SDK는 이 보안 규칙 자체를 우회하므로, 클라이언트는 classes/students 컬렉션에
//    어떤 방식으로도 직접 쓸 수 없게 완전히 잠근다.
// 2) 로그인에 성공하면 Cloud Functions가 Firebase Auth 커스텀 토큰을 발급하고,
//    그 토큰의 claims(classId, studentId)를 이 규칙들이 request.auth.token에서 읽어
//    "이 요청이 정말 그 학생 본인인지"를 판단한다.
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    match /classes/{classId} {
      // 참여 코드(joinCode)는 원래 칠판 등으로 공개 공유되는 값이라 읽기를 막을 이유가 없다.
      // manageCodeHash도 "해시"이므로 노출돼도 원본 관리코드를 복원할 수 없다.
      // ⚠️ 다만 이상적으로는 manageCodeHash를 별도 비공개 문서로 분리하는 편이 더 안전하다.
      allow get, list: if true;

      // 학급 생성은 createClass Cloud Function(Admin SDK)에서만 — 참여 코드/관리 코드
      // 발급과 해시 저장이 모두 서버에서 원자적으로 이루어져야 하므로 클라이언트 직접 생성은 금지.
      allow create, update, delete: if false;

      match /students/{nickname} {
        // 학생 비밀 정보(PIN 해시)는 어떤 경우에도 클라이언트가 직접 읽거나 쓸 수 없다.
        // 등록·로그인·PIN 재검증은 모두 Cloud Functions(Admin SDK)에서만 이루어진다.
        allow read, write: if false;
      }
    }

    // ── 기존 컬렉션 (이번 변경과 무관 — 지금 콘솔에 있는 규칙을 그대로 유지하세요) ──
    // 아래는 현재 앱 동작과 맞춰본 "예시"이며, 실제 콘솔에 이미 다른 조건이 있다면
    // 이 블록으로 덮어쓰지 말고 위 classes/students 블록만 추가하세요.
    match /artworks/{artworkId} {
      allow get, list: if true;

      // 개인 모드(classId/studentId 둘 다 null)는 기존처럼 누구나 생성 가능.
      // 학급 모드로 생성하려면 로그인(커스텀 토큰)의 classId/studentId와 반드시 일치해야 한다
      // — 그래야 "나는 학급 A 학생인데 학급 B 소속으로 위장해서 저장" 같은 스푸핑을 막는다.
      allow create: if
        (request.resource.data.classId == null && request.resource.data.studentId == null) ||
        (request.auth != null &&
         request.resource.data.classId == request.auth.token.classId &&
         request.resource.data.studentId == request.auth.token.studentId);

      // "이어 그리기" 덮어쓰기 저장. 로그인된 학생 본인 소유 작품만, 소유권 필드 자체는
      // 바꿀 수 없고 그림 데이터(pixelsJson 등)만 갱신할 수 있다.
      allow update: if
        request.auth != null &&
        resource.data.classId == request.auth.token.classId &&
        resource.data.studentId == request.auth.token.studentId &&
        request.resource.data.classId == resource.data.classId &&
        request.resource.data.studentId == resource.data.studentId;

      // 개인 모드(classId==null) 작품의 삭제는 서버 검증 없이(로컬 저장 ID 기반) 동작 중이라
      // 그대로 열어둠 — 이번 프롬프트 범위 밖의 기존 이슈. 별도로 다루는 걸 권장.
      // 학급 모드 작품은 이제 deleteClassArtwork Cloud Function(관리 코드 검증)에서만 지울 수
      // 있다 — 그 학급의 관리 코드를 아는 "진짜 선생님"만 지울 수 있어야 하기 때문.
      allow delete: if resource.data.classId == null;
    }

    match /wall/{postId} {
      allow get, list: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
